# Settings for the night reload on THIS Mac. install.sh copies this file to config.env once and never overwrites it.
# Every line is optional; what is written here is what the job does when the line is missing.

# The night window (this Mac's clock) and how long the keyboard and mouse must have been untouched.
WINDOW_START=0400
WINDOW_END=0530
IDLE_SECONDS=600

# Which browser's web apps to use: auto finds the one that has the Station and X open. Say brave or chrome if both do.
BROWSER=auto

# What to reload. The Hub reloads itself between 03:00 and 05:00 and comes back where Alan left it; a reload from this job
# brings it back on its first screen instead. Leave RELOAD_HUB=no unless Alan asks for it.
RELOAD_STATION=yes
RELOAD_X=yes
RELOAD_HUB=no

# This browser's line on https://station.scintillahub.ai/x-health/ (the first 8 characters of its id). Empty = read it from that
# page's own list by this Mac's name and browser ("iMac · Brave" -> 58feb66c on 7 Oct 2026). The id changes if the browser's
# site data for the Station is ever cleared; the dry run prints which one it is using.
X_HEALTH_CLIENT=

# Seconds to let the Station and X load before the shortcut, and to wait for the Station's once-a-minute "X is working" report.
LOAD_WAIT=25
HEALTH_WAIT=240

# ---- THE RESTART (8 Oct 2026) ------------------------------------------------------------------------------------------------
# Before the reload, the job closes and reopens the apps that fill this Mac's memory: TradingView, the Hub app, then Brave.
# RESTART_APPS=no makes the job exactly the 7 Oct reload-only job (rollback.sh --reload-only writes that for you).
# For a night that only watches and touches nothing: RELOAD_STATION=no and RESTART_APPS=no.
RESTART_APPS=yes
RESTART_TRADINGVIEW=yes
RESTART_HUB_APP=yes
RESTART_BRAVE=yes

# Where the three apps are. Brave is opened again through its own web apps (the Station, X), never by itself.
# TRADINGVIEW_APP=/Applications/TradingView.app
# HUB_APP=$HOME/Applications/SCINTILLA.app
# BRAVE_APP=/Applications/Brave Browser.app

# Seconds an app normally gets to close after being asked, and how many more it may take before it is left as it is.
# Nothing is ever forced to quit: an app that is still open after both is left alone and Alan gets a line in the morning.
QUIT_WAIT=30
QUIT_PATIENCE=60
# Seconds to wait for an app to be back, per try (two tries), and for Brave's reopened pages to draw before the reload.
OPEN_WAIT=60
SETTLE_WAIT=15
