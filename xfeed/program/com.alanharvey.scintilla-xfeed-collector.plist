<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Scintilla X Trading-list collector, as a program: launchd runs one source pass at
     06:30, 10:30, 14:30 and 18:30 local time (the iMac is on America/New_York).
     No chat session, no CUA. install-imac.sh substitutes the __PLACEHOLDERS__.
     A run that finds the browser signed out, X rate-limited, or the list changed
     publishes that state over the last good feed so the X Desk says it in words. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alanharvey.scintilla-xfeed-collector</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>__HUB__/scripts/xfeed-program.mjs</string>
        <string>run</string>
        <string>--runtime-dir</string>
        <string>__RUNTIME__</string>
        <string>--profile</string>
        <string>__PROFILE__</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__HUB__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>30</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>ExitTimeOut</key>
    <integer>90</integer>
    <key>StandardOutPath</key>
    <string>__RUNTIME__/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__RUNTIME__/logs/launchd.log</string>
</dict>
</plist>
